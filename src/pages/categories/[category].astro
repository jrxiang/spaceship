---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TagFilter from '../../components/TagFilter.astro';
import {
  getCategories,
  getPosts,
  getTags,
  slugify,
  type Post,
  type Term,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = getCategories(posts);

  return categories.map((term) => ({
    params: { category: term.slug },
    props: {
      term,
      posts: posts.filter((post) => slugify(post.data.category) === term.slug),
    },
  }));
}

interface Props {
  term: Term;
  posts: Post[];
}

const { term, posts } = Astro.props;
const tags = getTags(posts);
---

<BaseLayout
  title={term.name}
  description={`Posts filed under ${term.name}.`}
>
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">
        <a href="/categories">Categories</a>
      </p>
      <h1 class="page-title">{term.name}</h1>
      <p class="page-lead">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} in this category.
        See <a href="/tags">tags</a> for narrower topics.
      </p>
    </header>

    {tags.length > 0 && (
      <TagFilter
        tags={tags}
        listId="category-posts"
        emptyId="category-posts-empty"
        placeholder="Type or pick a tag…"
      />
    )}

    <div id="category-posts">
      <PostList posts={posts} />
    </div>

    <p class="empty-state" id="category-posts-empty" hidden>
      No posts in this category match that tag. Try a broader keyword or clear
      the filter.
    </p>
  </div>
</BaseLayout>
