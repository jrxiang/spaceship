---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';
import { formatDate, getCategories, getPosts, getTags } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const categories = getCategories(posts);
const tags = getTags(posts).slice(0, 12);
const githubUrl = SITE.social.find((link) => link.label === 'GitHub')?.href;
const rssUrl =
  SITE.social.find((link) => link.label === 'RSS')?.href ?? '/rss.xml';
const lastUpdated = posts.reduce<Date | undefined>((latestDate, post) => {
  const date = post.data.updated ?? post.data.published;
  return !latestDate || date > latestDate ? date : latestDate;
}, undefined);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Notes, essays &amp; references</p>

      <h1 class="display-title hero__title">{SITE.title}</h1>

      <a class="hero__avatar" href="/about" title={`About ${SITE.author}`}>
        <img
          src="/images/avatar.jpg"
          alt={`Portrait of ${SITE.author}`}
          width="120"
          height="113"
          decoding="async"
        />
      </a>

      <p class="hero__lead">{SITE.description}</p>
      <div class="hero__meta">
        <div class="hero__meta-facts">
          <span>{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
          {lastUpdated && <span>Last updated {formatDate(lastUpdated)}</span>}
          <a href="/about">About this site</a>
        </div>

        <ul class="hero__social">
          {
            SITE.email && (
              <li>
                <a
                  href={`mailto:${SITE.email}`}
                  aria-label={`Email ${SITE.author}`}
                  title="Email"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3.5 7.5 8.5 6 8.5-6" />
                  </svg>
                </a>
              </li>
            )
          }
          {
            githubUrl && (
              <li>
                <a href={githubUrl} aria-label="GitHub" title="GitHub" rel="me">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                  </svg>
                </a>
              </li>
            )
          }
          <li>
            <a href={rssUrl} aria-label="RSS feed" title="RSS feed">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" />
                <path d="M4 11a9 9 0 0 1 9 9" />
                <path d="M4 4a16 16 0 0 1 16 16" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Latest writing</h2>
        <a class="section__more" href="/posts">View all posts →</a>
      </div>
      <PostList posts={latest} emptyMessage="Nothing published yet." />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Browse by category</h2>
        <a class="section__more" href="/categories">All categories →</a>
      </div>
      <div class="chip-row chip-row--compact">
        {
          categories.map((category) => (
            <a class="chip" href={`/categories/${category.slug}/`}>
              {category.name}
              <span class="chip__count">{category.count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">Topics</h2>
        <a class="section__more" href="/tags">All tags →</a>
      </div>
      <div class="chip-row chip-row--compact">
        {
          tags.map((tag) => (
            <a class="chip" href={`/tags/${tag.slug}/`}>
              {tag.name}
              <span class="chip__count">{tag.count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
