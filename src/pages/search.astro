---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title="Search"
  description="Search every post by title, description, category, or tag."
>
  <div class="container page">
    <div class="reading">
      <header class="page-head">
        <p class="eyebrow">Search</p>
        <h1 class="page-title">Find a note</h1>
        <p class="page-lead">
          Search titles, descriptions, categories, and tags. Results update as
          you type.
        </p>
      </header>

      <div class="search-box">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16.5 16.5 4 4"></path>
        </svg>
        <label class="visually-hidden" for="search-input">Search posts</label>
        <input
          class="search-input"
          id="search-input"
          type="search"
          placeholder="Type a keyword, tag, or phrase…"
          autocomplete="off"
          spellcheck="false"
          autofocus
          data-total={posts.length}
        />
      </div>

      <p class="search-status" id="search-status" role="status" aria-live="polite">
        {posts.length} posts indexed.
      </p>

      <ol class="post-list" id="search-results"></ol>

      <noscript>
        <p class="empty-state">
          Search needs JavaScript. You can browse <a href="/posts">all posts</a>
          or the <a href="/tags">tag index</a> instead.
        </p>
      </noscript>

      <p class="search-hint search-hint--footer">
        Press <kbd>/</kbd> to focus the field · <a href="/tags">Browse by tag →</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    loadSearchRecords,
    renderResult,
    searchRecords,
  } from '../lib/search-client';

  const input = document.getElementById('search-input') as HTMLInputElement;
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');

  let records = [];
  let timer = 0;

  function updateUrl(query: string) {
    const url = query ? `/search?q=${encodeURIComponent(query)}` : '/search';
    history.replaceState(null, '', url);
  }

  function render() {
    const query = input.value.trim();
    updateUrl(query);

    if (records.length === 0) {
      results.innerHTML = '';
      return;
    }

    if (query === '') {
      status.textContent = `${records.length} posts indexed.`;
      results.innerHTML = records
        .slice(0, 15)
        .map((record) => renderResult(record, []))
        .join('');
      return;
    }

    const { terms, total, matches } = searchRecords(records, query, 20);

    status.textContent =
      total === 0
        ? `No matches for “${query}”. Try a broader keyword.`
        : `${total} ${total === 1 ? 'result' : 'results'} for “${query}”${
            total > matches.length ? `, showing the first ${matches.length}` : ''
          }.`;

    results.innerHTML = matches
      .map(({ record }) => renderResult(record, terms))
      .join('');
  }

  loadSearchRecords()
    .then((data) => {
      records = data;
      const initial = new URLSearchParams(window.location.search).get('q') ?? '';
      if (initial) input.value = initial;
      render();
    })
    .catch(() => {
      status.textContent =
        'Search index could not be loaded. Please reload the page or browse all posts.';
    });

  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(render, 100);
  });

  document.addEventListener('keydown', (event) => {
    if (
      event.key === '/' &&
      document.activeElement !== input &&
      !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '') &&
      !document.activeElement?.isContentEditable
    ) {
      event.preventDefault();
      input.focus();
    }
  });
</script>
