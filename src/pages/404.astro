---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <div class="container not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">This page is not in the notebook.</h1>
    <p class="not-found__lead">
      The link may be outdated, or the note may have been renamed. Try the
      archive or search instead.
    </p>
    <div class="not-found__actions">
      <a href="/">Home</a>
      <a href="/posts">All posts</a>
      <a href="/tags">Tags</a>
      <a href="/search" data-search-open>Search</a>
    </div>
  </div>
</BaseLayout>
