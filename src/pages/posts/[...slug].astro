---
import { render } from 'astro:content';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import '../../styles/fancybox.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { SITE } from '../../site.config';
import {
  formatDate,
  getPosts,
  getReadingTime,
  getRelatedPosts,
  postUrl,
  slugify,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, published, updated, category, tags } = post.data;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const posts = await getPosts();
const related = getRelatedPosts(post, posts, 3);

const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;

const canonical = new URL(postUrl(post), Astro.site ?? Astro.url.origin);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: published.toISOString(),
  dateModified: (updated ?? published).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: canonical.href,
};
---

<BaseLayout title={title} description={description} type="article">
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <article class="article container">
    <header class="article__header">
      <p class="eyebrow">
        <a href={`/categories/${slugify(category)}/`}>{category}</a>
      </p>
      <h1 class="article__title">{title}</h1>
      <p class="article__description">{description}</p>

      <div class="article__meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        <span class="sep" aria-hidden="true">/</span>
        <span>{readingTime} min read</span>
        {
          updated && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span>Updated {formatDate(updated)}</span>
            </>
          )
        }
        {
          tags.length > 0 && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span class="article__meta-tags">
                {tags.map((tag) => (
                  <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
                ))}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="article__layout">
      <aside class="article__aside">
        <TableOfContents headings={headings} />
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article__footer">
      {
        tags.length > 0 && (
          <div class="article__tags">
            <span class="label">Tags</span>
            {tags.map((tag) => (
              <a class="chip" href={`/tags/${slugify(tag)}/`}>
                {tag}
              </a>
            ))}
          </div>
        )
      }

      <h2 class="related-title">Related posts</h2>
      {
        related.length > 0 ? (
          <PostList posts={related} />
        ) : (
          <p class="empty-state">
            Nothing related yet. Browse <a href="/posts">all posts</a> instead.
          </p>
        )
      }

      {
        (newer || older) && (
          <nav class="post-nav" aria-label="Post navigation">
            {older ? (
              <a class="post-nav__link" href={postUrl(older)}>
                <span class="post-nav__label">← Older</span>
                <span class="post-nav__title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="post-nav__link post-nav__link--next" href={postUrl(newer)}>
                <span class="post-nav__label">Newer →</span>
                <span class="post-nav__title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</BaseLayout>

<script>
  import { Fancybox } from '@fancyapps/ui';

  const images = [
    ...document.querySelectorAll<HTMLImageElement>('.prose img'),
  ];

  for (const image of images) {
    if (image.parentElement?.tagName === 'A') continue;

    const source = image.currentSrc || image.src;
    const link = document.createElement('a');

    link.href = source;
    link.dataset.fancybox = 'gallery';
    link.dataset.caption = image.title || image.alt || '';
    link.dataset.thumb = source;

    image.replaceWith(link);
    link.appendChild(image);
  }

  /**
   * Rotating by 90 degrees swaps the image's width and height while the zoom
   * level stays the same, so a wide image ends up taller than the viewport.
   * Rescale it so the rotated box fits again. Shrinking is allowed (otherwise
   * the image would be cut off), growing past the opened size is not.
   */
  const fitRotatedImage = (panzoom: any, openedScale: number) => {
    const content = panzoom.getContent();
    const container = panzoom.getContainer();

    if (!content || !container) return;

    const box = container.getBoundingClientRect();
    const rect = content.getBoundingClientRect();

    if (!box.width || !box.height || !rect.width || !rect.height) return;

    // The caption/toolbar bar overlays the bottom of the container and Panzoom
    // centres the image in the space above it, so the fitted image has to stay
    // symmetric around the current centre or the top edge gets clipped.
    const caption = container
      .closest('.fancybox__slide')
      ?.querySelector('.f-caption');
    const bottomBar = caption?.getBoundingClientRect().height ?? 0;
    const centerX = (rect.left + rect.right) / 2 - box.left;
    const centerY = (rect.top + rect.bottom) / 2 - box.top;
    const availableWidth = 2 * Math.min(centerX, box.width - centerX);
    const availableHeight =
      2 * Math.min(centerY, box.height - bottomBar - centerY);

    if (availableWidth <= 0 || availableHeight <= 0) return;

    const ratio = Math.min(
      availableWidth / rect.width,
      availableHeight / rect.height,
    );
    const currentScale = panzoom.getScale();
    // Fit the rotated image, but never blow it up past the size it was
    // opened at.
    const scale = Math.min(openedScale, currentScale * ratio);

    if (Math.abs(scale - currentScale) < 0.001) return;

    // Let the fit shrink below the opened size, while keeping the user's own
    // zoom-out limited to the fitted size.
    panzoom.getOptions().minScale = Math.min(1, scale);
    panzoom.execute('zoomTo', { scale });
  };

  if (images.length > 0) {
    Fancybox.bind('[data-fancybox="gallery"]', {
      Hash: false,
      hideScrollbar: false,
      Carousel: {
        transition: 'slide',
        Thumbs: {
          showOnStart: false,
        },
        Toolbar: {
          // Required for the bottom-docked toolbar customisation to apply.
          absolute: true,
          display: {
            left: ['counter'],
            middle: [
              'zoomIn',
              'zoomOut',
              'toggle1to1',
              'rotateCCW',
              'rotateCW',
              'flipX',
              'flipY',
              'reset',
            ],
            right: ['autoplay', 'thumbs', 'close'],
          },
        },
        Zoomable: {
          Panzoom: {
            maxScale: 4,
            // Never zoom out below the size the image opened at.
            minScale: 1,
            // The image shows a grab cursor, so clicking must not zoom.
            clickAction: false,
            dblClickAction: false,
          },
        },
      },
      on: {
        'Carousel.panzoom:ready': (_fancybox: any, _carousel: any, slide: any) => {
          const panzoom = slide.panzoomRef;
          if (!panzoom) return;

          const openedScale = panzoom.getScale();
          let rotated = false;

          // The panzoom "action" event passes the action as the first
          // argument after the API instance, with no event object.
          panzoom.on('action', (_api: any, ...args: any[]) => {
            const action = args.find((value) => typeof value === 'string');

            if (action !== 'rotateCW' && action !== 'rotateCCW') return;

            rotated = true;

            // Fallback for when the rotation runs without an animation.
            setTimeout(() => {
              if (!rotated) return;
              rotated = false;
              fitRotatedImage(panzoom, openedScale);
            }, 400);
          });

          panzoom.on('animationEnd', () => {
            if (!rotated) return;
            rotated = false;
            fitRotatedImage(panzoom, openedScale);
          });


        },
      },
    });
  }
</script>
