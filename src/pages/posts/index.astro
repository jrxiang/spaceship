---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByYear } from '../../lib/posts';

const posts = await getPosts();
const groups = groupByYear(posts);
---

<BaseLayout
  title="All posts"
  description="Every post on the site, grouped by year."
>
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">Archive</p>
      <h1 class="page-title">All posts</h1>
      <p class="page-lead">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} in chronological
        order. For a smaller slice, browse <a href="/categories">categories</a>
        or <a href="/tags">tags</a>.
      </p>
    </header>

    {
      groups.map(({ year, posts }) => (
        <section class="archive-year">
          <h2 class="archive-year__label">{year}</h2>
          <PostList posts={posts} />
        </section>
      ))
    }
  </div>
</BaseLayout>
