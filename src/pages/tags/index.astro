---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

const posts = await getPosts();
const tags = getTags(posts);
---

<BaseLayout
  title="Tags"
  description="All tags on the site, with post counts."
>
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">Index</p>
      <h1 class="page-title">Tags</h1>
      <p class="page-lead">
        Tags cut across categories. Use them to follow a thread through notes,
        essays, and references.
      </p>
    </header>

    {
      tags.length > 0 ? (
        <ul class="tag-cloud">
          {tags.map((tag) => (
            <li>
              <a class="chip" href={`/tags/${tag.slug}/`}>
                {tag.name}
                <span class="chip__count">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">No tags yet.</p>
      )
    }
  </div>
</BaseLayout>
