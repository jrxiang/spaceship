---
import {
  formatDate,
  getReadingTime,
  postUrl,
  slugify,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
  /** Hide the summary for dense lists. */
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const { title, description, published, category, tags } = post.data;
const minutes = getReadingTime(post.body);
---

<li class="post-card" data-tags={tags.map(slugify).filter(Boolean).join('|')}>
  <time class="post-card__date" datetime={published.toISOString()}>
    {formatDate(published)}
  </time>

  <div>
    <h3 class="post-card__title">
      <a href={postUrl(post)}>{title}</a>
    </h3>

    {
      !compact && (
        <p class="post-card__description">{description}</p>
      )
    }

    <div class="post-card__meta">
      <a class="post-card__category" href={`/categories/${slugify(category)}/`}>
        {category}
      </a>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
      {
        tags.length > 0 && (
          <span class="post-card__tags" aria-label="Tags">
            {tags.map((tag) => (
              <a class="post-card__tag" href={`/tags/${slugify(tag)}/`}>
                {tag}
              </a>
            ))}
          </span>
        )
      }
    </div>
  </div>
</li>
