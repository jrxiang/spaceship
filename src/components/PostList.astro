---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  compact?: boolean;
  emptyMessage?: string;
}

const {
  posts,
  compact = false,
  emptyMessage = 'No posts yet.',
} = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty-state">{emptyMessage}</p>
  ) : (
    <ol class="post-list" class:list={{ 'post-list--compact': compact }}>
      {posts.map((post) => (
        <PostCard post={post} compact={compact} />
      ))}
    </ol>
  )
}
