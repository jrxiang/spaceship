---
// Global search overlay. Rendered once from BaseLayout so every page can open
// it without navigating away.
---

<dialog
  class="search-dialog"
  id="search-dialog"
  aria-labelledby="search-dialog-title"
>
  <div class="search-dialog__inner">
    <h2 class="visually-hidden" id="search-dialog-title">Search posts</h2>

    <div class="search-box">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4 4"></path>
      </svg>
      <label class="visually-hidden" for="search-dialog-input">Search posts</label>
      <input
        class="search-input"
        id="search-dialog-input"
        type="search"
        placeholder="Search titles, tags, or descriptions…"
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-dialog-results"
      />
    </div>

    <p
      class="search-status"
      id="search-dialog-status"
      role="status"
      aria-live="polite"
    ></p>

    <ol
      class="post-list search-dialog__results"
      id="search-dialog-results"
      aria-label="Search results"
    ></ol>

    <p class="search-hint search-hint--dialog">
      <kbd>↑</kbd> <kbd>↓</kbd> select · <kbd>Enter</kbd> open ·
      <kbd>Esc</kbd> or click outside to close
    </p>
  </div>
</dialog>

<script>
  import {
    loadSearchRecords,
    renderResult,
    searchRecords,
  } from '../lib/search-client';
  import type { SearchRecord } from '../lib/search-client';

  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');

  if (dialog) {
    const input = document.querySelector<HTMLInputElement>('#search-dialog-input');
    const status = document.querySelector<HTMLElement>('#search-dialog-status');
    const results = document.querySelector<HTMLElement>('#search-dialog-results');
    // On the standalone search page keep using the field that is already open.
    const pageInput = document.querySelector<HTMLInputElement>('#search-input');

    if (input && status && results) {
      let records: SearchRecord[] = [];
      let loading: Promise<void> | null = null;
      let timer = 0;
      let activeIndex = -1;

      const resultItems = () =>
        [...results.querySelectorAll<HTMLElement>('.search-result')];

      const setActive = (index: number) => {
        const items = resultItems();
        if (items.length === 0) return;

        activeIndex = ((index % items.length) + items.length) % items.length;
        items.forEach((item, i) => {
          item.classList.toggle('is-active', i === activeIndex);
        });
        items[activeIndex].scrollIntoView({ block: 'nearest' });
      };

      const ensureIndex = () => {
        if (records.length > 0) return Promise.resolve();
        if (!loading) {
          status.textContent = 'Loading index…';
          loading = loadSearchRecords()
            .then((data) => {
              records = data;
            })
            .catch(() => {
              loading = null;
              status.textContent =
                'Search index could not be loaded. Please reload the page.';
            });
        }
        return loading;
      };

      const render = () => {
        const query = input.value.trim();

        if (records.length === 0) {
          results.innerHTML = '';
          activeIndex = -1;
          return;
        }

        if (query === '') {
          status.textContent = `${records.length} posts indexed — start typing.`;
          results.innerHTML = '';
          activeIndex = -1;
          return;
        }

        const { terms, total, matches } = searchRecords(records, query, 8);

        status.textContent =
          total === 0
            ? `No matches for “${query}”.`
            : `${total} ${total === 1 ? 'result' : 'results'} for “${query}”${
                total > matches.length
                  ? `, showing the first ${matches.length}`
                  : ''
              }.`;

        results.innerHTML = matches
          .map(({ record }) => renderResult(record, terms))
          .join('');
        activeIndex = -1;
        results.scrollTop = 0;
      };

      let closing = false;
      let closeTimer = 0;
      const reduceMotion =
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Locking the page would remove the scrollbar and shift the layout to the
      // right, so reserve its width as body padding for as long as it is open.
      const lockScroll = () => {
        const scrollbar =
          window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.setProperty(
          '--dialog-scrollbar',
          `${scrollbar}px`,
        );
        document.documentElement.classList.add('is-dialog-open');
      };

      const unlockScroll = () => {
        document.documentElement.classList.remove('is-dialog-open');
        document.documentElement.style.removeProperty('--dialog-scrollbar');
      };

      const open = async () => {
        if (pageInput) {
          pageInput.focus();
          pageInput.select();
          return;
        }

        if (closing) {
          window.clearTimeout(closeTimer);
          dialog.classList.remove('is-closing');
          closing = false;
        }

        if (typeof dialog.showModal === 'function') {
          if (!dialog.open) dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
        lockScroll();
        activeIndex = -1;
        input.focus();
        input.select();

        await ensureIndex();
        render();
      };

      const close = () => {
        if (closing) return;
        if (!dialog.open && !dialog.hasAttribute('open')) return;

        closing = true;
        dialog.classList.add('is-closing');

        // Let the exit animation play before hiding the dialog.
        closeTimer = window.setTimeout(() => {
          dialog.classList.remove('is-closing');
          closing = false;
          if (typeof dialog.close === 'function' && dialog.open) {
            dialog.close();
          } else {
            dialog.removeAttribute('open');
            unlockScroll();
          }
        }, reduceMotion ? 0 : 160);
      };

      dialog.addEventListener('close', unlockScroll);

      // Animate the native Esc/cancel path as well.
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        close();
      });

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          close();
        }
      });

      for (const trigger of document.querySelectorAll('[data-search-open]')) {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          void open();
        });
      }

      input.addEventListener('input', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(render, 100);
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setActive(activeIndex + 1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          setActive(activeIndex - 1);
        } else if (event.key === 'Enter') {
          const items = resultItems();
          const item = items[activeIndex >= 0 ? activeIndex : 0];
          const link = item?.querySelector('a');
          if (link) {
            event.preventDefault();
            link.click();
          }
        }
      });

      document.addEventListener('keydown', (event) => {
        const target = event.target;
        const typing =
          target instanceof HTMLElement &&
          (target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable);

        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === 'k'
        ) {
          event.preventDefault();
          void open();
          return;
        }

        if (event.key === '/' && !typing) {
          event.preventDefault();
          void open();
        }
      });
    }
  }
</script>
